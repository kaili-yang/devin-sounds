      { "label": "活干完了，可以摸鱼了", "tts": { "text": "活干完了，可以摸鱼了。", "lang": "zh_CN", "voices": ["Tingting", "Flo", "Sandy"] } }
    ] },
    "input.required": { "sounds": [
      { "label": "老板，这个得你拍板", "tts": { "text": "老板，这个得你拍板。", "lang": "zh_CN", "voices": ["Tingting", "Flo", "Sandy"] } },
      { "label": "需要你审批一下", "tts": { "text": "老板，需要你审批一下。", "lang": "zh_CN", "voices": ["Tingting", "Flo", "Sandy"] } }
