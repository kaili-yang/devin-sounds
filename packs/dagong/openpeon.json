    "user.spam": { "sounds": [
      { "label": "别催了别催了，在做了", "tts": { "text": "别催了别催了，在做了！", "lang": "zh_CN", "voices": ["Tingting", "Flo", "Sandy"] } }
    ] },
    "session.end": { "sounds": [
      { "label": "下班了下班了", "tts": { "text": "下班了，下班了！", "lang": "zh_CN", "voices": ["Tingting", "Flo", "Sandy"] } }
