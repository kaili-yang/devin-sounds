      { "label": "Got it, got it!", "tts": { "text": "Got it, got it!", "lang": "en_US", "voices": ["Samantha", "Flo", "Sandy"] } },
      { "label": "Right away!", "tts": { "text": "Right away!", "lang": "en_US", "voices": ["Samantha", "Flo", "Sandy"] } }
    ] },
    "task.complete": { "sounds": [
      { "label": "Done, boss!", "tts": { "text": "Done, boss!", "lang": "en_US", "voices": ["Samantha", "Flo", "Sandy"] } },
      { "label": "All done. Can I take a coffee break now?", "tts": { "text": "All done. Can I take a coffee break now?", "lang": "en_US", "voices": ["Samantha", "Flo", "Sandy"] } }
